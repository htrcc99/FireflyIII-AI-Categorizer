# Environment for the Firefly III AI Categorizer — copy to .env and fill in.
#
# Every variable is optional: credentials can also be entered on the Settings
# page, and values saved there override the ones below.
#
# IMPORTANT: leave optional variables commented out rather than empty. An empty
# value (e.g. "OPENAI_MODEL=") overrides the default instead of using it, and
# an empty HISTORY_CACHE_TTL stops the server from starting.

# ── Firefly III connection ─────────────────────────────────────────────────
# URL as seen from inside the container (not "localhost" unless on the same
# network namespace). Personal Access Token: Firefly III → Profile → OAuth.
FIREFLY_URL=
FIREFLY_PERSONAL_TOKEN=

# ── AI provider ────────────────────────────────────────────────────────────
# openai (also Ollama / Azure / any OpenAI-compatible API), gemini or deepseek.
#AI_PROVIDER=openai

OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
# Local model via Ollama: point the base URL at it and leave the key empty.
#OPENAI_BASE_URL=http://ollama:11434/v1

#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.1-flash-lite

#DEEPSEEK_API_KEY=
#DEEPSEEK_MODEL=deepseek-chat

# ── Jev pre-classifier (optional) ──────────────────────────────────────────
# Asks TypeSafe's Jev (via OpenRouter) first; only uncertain cases reach the
# AI provider above, which must still be configured as the fallback.
#JEV_ENABLED=true
OPENROUTER_API_KEY=
#JEV_MODEL=typesafe/jev-1.13
# Accept Jev's answer at or above HIGH; flag for review below LOW; send
# anything in between to the AI provider. Must satisfy 0 <= LOW <= HIGH <= 1.
#JEV_HIGH_THRESHOLD=0.85
#JEV_LOW_THRESHOLD=0.50

# ── Behaviour ──────────────────────────────────────────────────────────────
# Tags written to transactions: <prefix>:classified, :assumed, :needs-review.
#TAG_PREFIX=ai
# Also match or create the expense account (payee) for each withdrawal.
#DESTINATION_MATCH_ENABLED=true

# ── History context ────────────────────────────────────────────────────────
#HISTORY_CONTEXT_LIMIT=5
#HISTORY_LOOKBACK_DAYS=90
#HISTORY_CACHE_TTL=10m

# ── Processing ─────────────────────────────────────────────────────────────
# Parallel webhook jobs (increase with caution) and parallel batch jobs.
#WORKER_CONCURRENCY=1
#BATCH_CONCURRENCY=5

# ── Server ─────────────────────────────────────────────────────────────────
# Set to false to serve only the webhook/API without the web UI.
#ENABLE_UI=true
# PORT is the port *inside* the container. Change the left side of "ports" in
# docker-compose.example.yml instead if you want a different host port.
#PORT=3000
